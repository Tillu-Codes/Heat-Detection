# NASA FIRMS API Configuration
# Get your free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=your_firms_map_key_here

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Ingestion Settings
DEFAULT_SENSOR=VIIRS_NOAA20_NRT
DEFAULT_DAY_RANGE=3
DEFAULT_REGION=world

# Persistence and Anomaly Thresholds
CLUSTER_RADIUS_KM=1.0
PERSISTENCE_MIN_HITS=3
ANOMALY_ZSCORE_THRESHOLD=2.5
